# Local development
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB — local OR Atlas
# MONGODB_URI=mongodb://127.0.0.1:27017/shop_os
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shop_os?retryWrites=true&w=majority&appName=Cluster0

# Frontend origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Min 16 chars — change in production
SESSION_SECRET=dev-only-session-secret-change-me
