# Copy these into Render → Web Service → Environment
# Values: apps/api/.env se copy kar sakte ho (MONGODB_URI + SESSION_SECRET)

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Atlas connection (password apna daalo)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shop_os?retryWrites=true&w=majority&appName=Cluster0

# Frontend live URL (Vercel/Netlify) — trailing slash mat lagana
CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app

# 32+ char random secret (local .env wala use karo ya naya banao)
SESSION_SECRET=replace-with-strong-random-secret-min-16-chars
