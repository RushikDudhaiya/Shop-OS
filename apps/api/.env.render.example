# Copy into Render → Environment

NODE_ENV=production
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shop_os?retryWrites=true&w=majority&appName=Cluster0
CORS_ORIGIN=https://shop-os-web.vercel.app
SESSION_SECRET=replace-with-strong-random-secret-min-16-chars
SHOW_LOGIN_OTP=true
